generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Config {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // Sees /admin and connects Instagram without going through the access queue.
  isAdmin      Boolean  @default(false)

  profiles       Profile[]
  accessRequests AccessRequest[]
}

// While the Meta app is unpublished, only Instagram accounts listed as testers
// in the app dashboard can authorize it. Users submit their handle here, the
// admin adds it as a tester on Meta and approves the row, which unlocks the
// "Conectar com Instagram" button for that user.
// Goes away once the app clears App Review (set IG_ACCESS_GATE=off).
model AccessRequest {
  id         Int       @id @default(autoincrement())
  igHandle   String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, igHandle])
  @@index([status])
}

model Profile {
  id          Int     @id @default(autoincrement())
  name        String

  // Owner. Nullable for profiles created before accounts existed — the first
  // user to sign up claims them (see signup action).
  userId      Int?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Instagram credentials (fallback to env vars when empty — for the legacy default profile)
  igUserId       String    @default("")
  igUsername     String?
  accessToken    String    @default("") @db.Text
  tokenExpiresAt DateTime?

  // Which API the accessToken belongs to — decides the Graph host used when
  // publishing. "instagram" = Instagram Login (graph.instagram.com),
  // "facebook" = Page token via Facebook Login (graph.facebook.com, legacy).
  authProvider   String    @default("facebook")

  // Content
  topics      String  @db.Text @default("Technology")

  // Brand identity
  brandName        String?
  brandDescription String? @db.Text
  brandColors      String?
  brandStyle       String?
  brandLogoUrl     String? @db.Text
  brandExtra       String? @db.Text
  linkUrl          String?
  useLogo          Boolean @default(false)
  lessText         Boolean @default(false)

  // Image design controls (typography, colors, effects for the generated graphic)
  designFontStyle  String?
  designFontSize   String?
  designFontColor  String?
  designEffects    String? @db.Text
  designNotes      String? @db.Text
  designImageStyles String? @db.Text

  // Multiselect brand options (CSV). When alternateStyles is on, one is picked
  // at random per post; otherwise all selected are applied together.
  brandStyles     String? @db.Text
  postTones       String? @db.Text
  brandFormats    String? @db.Text
  brandPalette    String? @db.Text
  alternateStyles Boolean @default(true)

  // Scheduling (per profile). Times are America/Sao_Paulo wall-clock.
  scheduleDays       String?   // CSV of weekday numbers, 0=Sun … 6=Sat
  scheduleTimes      String?   // CSV of "HH:MM"
  lastScheduledRunAt DateTime?

  // Behaviour
  autopost    Boolean  @default(false)
  active      Boolean  @default(true)

  posts       Post[]
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Post {
  id        Int      @id @default(autoincrement())
  caption   String   @db.Text
  imageUrl  String   @db.LongText
  igMediaId String?
  published Boolean  @default(false)
  status    String   @default("DRAFT")
  error     String?  @db.Text
  createdAt DateTime @default(now())

  profileId Int      @default(1)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
